/* Global application stylesheet — tokens from design system */

/* ── Base ── */
QWidget {{
    font-family: {font_family};
    font-size: {size_body}px;
    color: {text_primary};
    background-color: transparent;
}}
QMainWindow {{
    background-color: {bg_base};
}}
QWidget#MainCentral {{
    background-color: {bg_base};
}}
QStackedWidget#MainViewStack {{
    background-color: {bg_base};
}}

/* ── Home surfaces (theme via global QSS, not inline Python) ── */
QWidget#HomeSurface {{
    background-color: {bg_base};
}}
QScrollArea#HomePageScroll {{
    background: {bg_base};
    border: none;
}}
QFrame#SearchBarDivider {{
    background: {border_subtle};
    border: none;
    max-width: 1px;
    min-width: 1px;
}}
QLabel#FilterActiveBadge {{
    background: {senai_orange};
    border-radius: 3px;
    border: none;
}}
QWidget#HomeCenteredColumn {{
    background-color: {bg_base};
}}
QScrollArea#HomePanelScroll {{
    background: {bg_base};
    border: none;
}}
QWidget#HomeScrollContent {{
    background-color: {bg_base};
}}
QFrame#HomeListCard {{
    background: {bg_surface};
    border: 1px solid {border};
    border-radius: {radius_md}px;
}}
QFrame#HomeProjectRow:hover QLineEdit#HomeProjectTitle {{
    border-bottom: 1px solid {border_subtle};
}}
QLineEdit#HomeProjectTitle {{
    background: transparent;
    border: none;
    border-bottom: 1px solid transparent;
    border-radius: 0;
    font-size: {size_body}px;
    font-weight: {weight_semibold};
    color: {text_primary};
    padding: 0 0 2px 0;
}}
QLineEdit#HomeProjectTitle:hover {{
    border-bottom: 1px solid {border_subtle};
}}
QLineEdit#HomeProjectTitle:focus {{
    border-bottom: 1px solid {senai_blue_light};
}}
QToolButton#HomeProjectTitleEditBtn {{
    background: transparent;
    border: none;
    padding: 2px;
    border-radius: {radius_sm}px;
    min-width: 24px;
    min-height: 24px;
}}
QFrame#HomeProjectRow:hover QToolButton#HomeProjectTitleEditBtn {{
    background: rgba(74, 111, 212, 0.12);
}}
QToolButton#HomeProjectTitleEditBtn:hover {{
    background: rgba(74, 111, 212, 0.18);
}}
QWidget#HomeTabBarShell {{
    background: {bg_base};
    border: none;
    border-bottom: 1px solid {border};
}}
QWidget#HomeTabBarShell[stuck="true"] {{
    background: {bg_base};
    border-bottom: 1px solid {border};
}}
QComboBox#FilterCombo {{
    background-color: {bg_surface};
    border: 1px solid {border};
    border-radius: {radius_sm}px;
    padding: 6px 28px 6px 10px;
    color: {text_primary};
    min-height: 20px;
}}
QComboBox#FilterCombo:hover {{
    border-color: {border_strong};
    background-color: {bg_surface_alt};
}}
QComboBox#FilterCombo:focus {{
    border: 1.5px solid {senai_blue_light};
}}
QComboBox#FilterCombo::drop-down {{
    border: none;
    width: 22px;
}}
QListView#FilterComboPopup {{
    background-color: {bg_elevated};
    color: {text_primary};
    border: 1px solid {border_strong};
    border-radius: {radius_sm}px;
    padding: 4px;
    outline: none;
}}
QListView#FilterComboPopup::item {{
    padding: 8px 12px;
    border-radius: 4px;
    min-height: 24px;
}}
QListView#FilterComboPopup::item:hover {{
    background-color: {bg_surface_alt};
}}
QListView#FilterComboPopup::item:selected {{
    background-color: rgba(240, 67, 30, 0.22);
    color: {text_primary};
}}
QTabBar#HomeTabBar {{
    background: transparent;
    border: none;
}}
QTabBar#HomeTabBar::tab {{
    background: transparent;
    color: {text_muted};
    border: none;
    border-bottom: 2px solid transparent;
    padding: 10px 18px;
    font-size: {size_body}px;
    font-weight: {weight_medium};
    margin-right: 4px;
}}
QTabBar#HomeTabBar::tab:selected {{
    color: {senai_orange};
    border-bottom: 2px solid {senai_orange};
    font-weight: {weight_semibold};
}}
QTabBar#HomeTabBar::tab:hover {{
    color: {text_primary};
}}
QLabel#SectionHeaderTitle {{
    color: {text_primary};
    font-size: 20px;
    font-weight: {weight_bold};
    background: transparent;
    border: none;
}}
QLabel#SectionHeaderSubtitle {{
    color: {text_muted};
    font-size: 13px;
    background: transparent;
    border: none;
}}

/* ── Workspace surfaces ── */
QWidget#WorkspaceSurface {{
    background-color: {bg_base};
}}
QWidget#WorkspaceActionBar {{
    background-color: transparent;
    border: none;
}}
QWidget#WorkspacePreviewHeader {{
    background-color: {bg_surface};
    border-bottom: 1px solid {border};
    min-height: 48px;
}}
QWidget#WorkspaceProjectTitleRow {{
    background-color: {bg_surface};
    border-bottom: 1px solid {border};
}}
QLineEdit#WorkspaceProjectTitle {{
    background: transparent;
    border: none;
    border-bottom: 1px solid transparent;
    border-radius: 0;
    font-size: {size_h3}px;
    font-weight: {weight_semibold};
    color: {text_primary};
    padding: 2px 0 6px 0;
    min-height: 32px;
}}
QLineEdit#WorkspaceProjectTitle:hover {{
    border-bottom: 1px solid {border_subtle};
}}
QLineEdit#WorkspaceProjectTitle:focus {{
    border-bottom: 1px solid {senai_blue_light};
}}
QToolButton#WorkspaceProjectTitleEditBtn {{
    background: transparent;
    border: none;
    padding: 4px;
    border-radius: {radius_sm}px;
    min-width: 28px;
    min-height: 28px;
}}
QToolButton#WorkspaceProjectTitleEditBtn:hover {{
    background: rgba(74, 111, 212, 0.12);
}}
QWidget#WorkspaceProjectTabsStrip {{
    background-color: {bg_surface};
    border-bottom: 1px solid {border};
}}
QFrame#WorkspaceTopBarSeparator {{
    color: {border};
    background: {border};
    max-width: 1px;
    min-height: 28px;
    max-height: 28px;
    margin: 0 {xs}px;
}}
QPushButton#WorkspaceAddPdfTab {{
    background: transparent;
    color: {senai_orange};
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 12px;
    font-size: {size_caption}px;
    font-weight: {weight_medium};
    min-height: 28px;
}}
QPushButton#WorkspaceAddPdfTab:hover {{
    color: {text_primary};
    background: {bg_surface_alt};
    border-bottom: 2px solid rgba(240, 67, 30, 0.45);
}}
QPushButton#WorkspaceAddPdfTab:pressed {{
    background: {bg_surface_alt};
}}
QPushButton#WorkspaceChromeButton {{
    background-color: {bg_surface};
    border: 1px solid {border};
    border-radius: {radius_sm}px;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    padding: 0;
}}
QPushButton#WorkspaceChromeButton:hover {{
    border-color: {border_strong};
    background-color: {bg_surface_alt};
}}
QPushButton#WorkspaceChromeButton:pressed {{
    background-color: {bg_elevated};
}}
QWidget#WorkspacePreviewContext {{
    background: transparent;
    min-height: 32px;
}}
QWidget#LayoutTemplateSelector {{
    background: transparent;
}}
QWidget#WorkspaceTabsRow {{
    background: transparent;
}}
QWidget#WorkspacePreviewPanel {{
    background-color: {bg_base};
}}
QScrollArea#WorkspacePreviewScroll {{
    background: {bg_base};
    border: none;
}}
QFrame#WorkspaceSidebar {{
    background-color: {bg_sidebar};
    border-right: 1px solid {border};
}}
QTabWidget#WorkspaceSidebarTabs::pane {{
    border: none;
    background: transparent;
    top: -1px;
}}
QTabWidget#WorkspaceSidebarTabs QTabBar::tab {{
    background: transparent;
    color: {text_muted};
    padding: 10px 14px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: {size_caption}px;
    font-weight: {weight_medium};
}}
QTabWidget#WorkspaceSidebarTabs QTabBar::tab:selected {{
    color: {text_primary};
    border-bottom: 2px solid {senai_orange};
}}
QTabWidget#WorkspaceSidebarTabs QTabBar::tab:hover {{
    color: {text_secondary};
    background: {bg_surface_alt};
}}

QFrame#WorkspaceEditorView {{
    background-color: {bg_sidebar};
    border-right: 1px solid {border};
}}
QTabWidget#SectionEditorTabs::pane {{
    border: none;
    background: transparent;
    top: -1px;
}}
QTabWidget#SectionEditorTabs QTabBar::tab {{
    background: transparent;
    color: {text_muted};
    padding: 10px 14px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: {size_caption}px;
    font-weight: {weight_medium};
}}
QTabWidget#SectionEditorTabs QTabBar::tab:selected {{
    color: {text_primary};
    border-bottom: 2px solid {senai_orange};
}}
QTabWidget#SectionEditorTabs QTabBar::tab:hover {{
    color: {text_secondary};
    background: {bg_surface_alt};
}}
QScrollArea#SectionEditorScroll {{
    background: transparent;
    border: none;
}}
QWidget#EditorPanelHeader {{
    background: transparent;
}}
QFrame#WorkspaceEditorPanel {{
    background-color: {bg_surface};
    border-right: 1px solid {border};
}}
QLabel#WorkspaceEditorPlaceholder {{
    color: {text_muted};
    font-size: {size_body}px;
    padding: {xl}px;
    background: transparent;
}}

QScrollArea#GlobalFieldsScroll {{
    background: transparent;
    border: none;
}}
QFrame#GlobalFieldsPanel {{
    background: transparent;
    border: none;
}}
QFrame#GlobalFieldCard {{
    background: {bg_surface};
    border: 1px solid {border};
    border-radius: {radius_sm}px;
}}
QFrame#GlobalFieldCard:hover {{
    border-color: {border_strong};
}}
QFrame#GlobalFieldCard[locked="true"] {{
    background: {bg_surface_alt};
    border-color: {border_subtle};
}}
QFrame#GlobalFieldCard[locked="true"] QCheckBox,
QCheckBox[locked="true"] {{
    color: {text_muted};
}}
QCheckBox[locked="true"]::indicator:checked {{
    background-color: {text_muted};
    border: 1px solid {border_strong};
}}
QCheckBox[locked="true"]::indicator {{
    background-color: {bg_elevated};
    border: 1px solid {border};
}}
QLabel#GlobalFieldLabel {{
    color: {text_primary};
    font-size: {size_caption}px;
    font-weight: {weight_semibold};
    background: transparent;
}}
QLabel#GlobalFieldMeta {{
    color: {text_muted};
    font-size: {size_caption}px;
    background: transparent;
}}
QLineEdit#GlobalFieldInput {{
    background-color: {bg_surface_alt};
    border: 1px solid {border};
    border-radius: {radius_sm}px;
    padding: 8px 10px;
    color: {text_primary};
    font-size: {size_body}px;
    min-height: 36px;
}}
QLineEdit#GlobalFieldInput:focus {{
    border: 1.5px solid {senai_blue_light};
    background-color: {bg_surface};
}}
QLabel#FieldRestoreLink {{
    color: {senai_blue_light};
    font-size: {size_caption}px;
    background: transparent;
}}
QLabel#FieldRestoreLink:hover {{
    color: {text_primary};
}}
QWidget#SidebarTabHeader {{
    background: transparent;
}}
QListWidget#SectionSummaryList {{
    background: transparent;
    border: none;
    outline: none;
    padding: 0 {sm}px;
}}
QListWidget#SectionSummaryList::item {{
    background: transparent;
    border: none;
    padding: 0;
    margin: 0 0 6px 0;
}}
QListWidget#SectionSummaryList::item:selected {{
    background: transparent;
}}
QListWidget#SectionSummaryList::item:hover {{
    background: transparent;
}}
QListWidget#SectionSummaryList[dragging="true"]::item:hover {{
    background: transparent;
}}
QListWidget#SectionSummaryList[dragging="true"] QFrame#SectionSummaryRow:hover {{
    background: transparent;
    border-color: transparent;
}}
QWidget#SectionDropLine {{
    background: transparent;
    border: none;
}}
QFrame#SectionSummaryRow {{
    background: transparent;
    border: 1px solid transparent;
    border-radius: {radius_sm}px;
    min-height: 48px;
}}
QFrame#SectionSummaryRow:hover,
QFrame#SectionSummaryRow[hovered="true"] {{
    background: {bg_surface_alt};
    border-color: {border_subtle};
}}
QFrame#SectionSummaryRow[active="true"] {{
    background: rgba(74, 111, 212, 0.14);
    border-color: rgba(74, 111, 212, 0.45);
}}
QFrame#SectionSummaryRow[fixed="true"] {{
    background: rgba(255, 255, 255, 0.02);
}}
QFrame#SectionSummaryRow[fixed="true"] QLabel#SectionSummaryTitle {{
    color: {text_muted};
}}
QLabel#SectionSummaryGrip {{
    background: transparent;
}}
QToolButton#SectionSummaryLock {{
    background: transparent;
    border: none;
    padding: 2px;
    border-radius: {radius_sm}px;
}}
QToolButton#SectionSummaryLock:hover {{
    background: rgba(74, 111, 212, 0.12);
}}
QFrame#SectionSummaryAccent {{
    background: transparent;
    border: none;
    border-radius: 2px;
    margin: 8px 0 8px 0;
}}
QFrame#SectionSummaryAccent[active="true"] {{
    background: {senai_orange};
}}
QLabel#SectionSummaryNumber {{
    color: {text_muted};
    font-size: {size_caption}px;
    font-weight: {weight_semibold};
    background: transparent;
}}
QLabel#SectionSummaryTitle {{
    color: {text_primary};
    font-size: {size_body}px;
    font-weight: {weight_medium};
    background: transparent;
}}
QLabel#SectionSummaryMeta {{
    color: {text_muted};
    font-size: {size_caption}px;
    background: transparent;
}}
QLabel#SectionSummaryModified {{
    color: {senai_orange};
    font-size: 9px;
    background: transparent;
}}
QLabel#SectionSummaryBadge {{
    color: {senai_blue_light};
    background: rgba(74, 111, 212, 0.15);
    border-radius: 10px;
    padding: 2px 7px;
    font-size: {size_caption}px;
    font-weight: {weight_semibold};
}}
QFrame#SectionSummaryAddRow {{
    background: transparent;
    border: 1px dashed {border_subtle};
    border-radius: {radius_sm}px;
    min-height: 52px;
}}
QFrame#SectionSummaryAddRow:hover {{
    border-color: {senai_blue_light};
    background: {bg_surface_alt};
}}
QLabel#SectionSummaryAddLabel {{
    color: {text_secondary};
    font-size: {size_body}px;
    background: transparent;
}}
QToolButton#SectionSummaryAction {{
    background: transparent;
    border: none;
    padding: 4px;
    border-radius: {radius_sm}px;
}}
QToolButton#SectionSummaryAction:hover {{
    background: rgba(74, 111, 212, 0.15);
}}
QToolButton#SectionSummaryActionDanger {{
    background: transparent;
    border: none;
    padding: 4px;
    border-radius: {radius_sm}px;
}}
QToolButton#SectionSummaryActionDanger:hover {{
    background: {danger_bg};
}}
QTabBar#WorkspaceProjectTabs {{
    background: transparent;
    border: none;
}}
QTabBar#WorkspaceProjectTabs::tab {{
    background: transparent;
    color: {text_muted};
    padding: 6px 12px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: {size_caption}px;
    font-weight: {weight_medium};
    min-height: 18px;
}}
QTabBar#WorkspaceProjectTabs::tab:selected {{
    color: {text_primary};
    border-bottom: 2px solid {senai_orange};
    font-weight: {weight_semibold};
}}
QTabBar#WorkspaceProjectTabs::tab:hover {{
    color: {text_secondary};
    background: {bg_surface_alt};
}}
QLabel#WorkspaceMetaLabel {{
    font-size: {size_caption}px;
    color: {text_muted};
    background: transparent;
}}
QLabel#WorkspaceMetaSeparator {{
    font-size: {size_caption}px;
    color: {text_disabled};
    background: transparent;
    padding: 0 2px;
}}
QLabel#WorkspaceLayoutDirty {{
    font-size: 10px;
    color: {senai_orange};
    background: transparent;
}}
QLabel#WorkspaceDataDirty {{
    font-size: {size_caption}px;
    color: {senai_orange};
    background: transparent;
}}
QLabel#WorkspacePreviewStatus {{
    font-size: {size_caption}px;
    color: {text_muted};
    background: transparent;
}}
QWidget#PreviewBusyOverlay {{
    background: transparent;
}}
QProgressBar#PreviewBusyIndicator {{
    border: none;
    border-radius: 2px;
    background: {bg_surface_alt};
}}
QProgressBar#PreviewBusyIndicator::chunk {{
    background: {senai_orange};
    border-radius: 2px;
}}
QLabel#WorkspaceDocTitle {{
    font-size: {size_h3}px;
    font-weight: {weight_semibold};
    color: {text_primary};
    background: transparent;
}}
QLabel#WorkspaceDocTitleCompact {{
    font-size: {size_body}px;
    font-weight: {weight_semibold};
    color: {text_primary};
    background: transparent;
}}
QLabel#WorkspaceActiveSection {{
    font-size: {size_caption}px;
    color: {text_muted};
    background: transparent;
}}
QLabel#SidebarSectionTitle {{
    font-size: {size_caption}px;
    font-weight: {weight_bold};
    color: {text_muted};
    letter-spacing: 1px;
    background: transparent;
}}
QLabel#WorkspacePageLabel {{
    font-weight: {weight_semibold};
    color: {text_muted};
    background: transparent;
}}
QLabel#WorkspacePreviewPage {{
    background: {bg_surface};
    border: 1px solid {border};
    border-radius: {radius_md}px;
    padding: {sm}px;
}}

QFrame#SidebarDivider {{
    background-color: {border};
    border: none;
    max-height: 1px;
}}
QLabel#SidebarHint {{
    color: {text_muted};
    font-size: {size_caption}px;
    background: transparent;
    border: none;
}}

QDialog {{
    background-color: {bg_surface};
    border: 1px solid {border};
}}

/* ── Tooltip ── */
QToolTip {{
    background-color: {bg_elevated};
    color: {text_primary};
    border: 1px solid {border_strong};
    padding: 6px 10px;
    border-radius: {radius_sm}px;
    font-size: {size_caption}px;
}}

/* ── Inputs ── */
QLineEdit, QTextEdit {{
    background-color: {bg_surface_alt};
    border: 1px solid {border};
    border-radius: {radius_sm}px;
    padding: 8px 12px;
    color: {text_primary};
    selection-background-color: {senai_blue};
    selection-color: {text_on_primary};
}}
QLineEdit:focus, QTextEdit:focus {{
    border: 1.5px solid {senai_blue_light};
    background-color: {bg_surface};
}}
QLineEdit:disabled, QTextEdit:disabled {{
    color: {text_disabled};
    border-color: {border_subtle};
}}

/* ── ComboBox ── */
QComboBox {{
    background-color: {bg_surface_alt};
    border: 1px solid {border};
    border-radius: {radius_sm}px;
    padding: 6px 12px;
    color: {text_primary};
}}
QComboBox:focus {{
    border: 1.5px solid {senai_blue_light};
}}
QComboBox QAbstractItemView {{
    background-color: {bg_elevated};
    border: 1px solid {border_strong};
    color: {text_primary};
    selection-background-color: rgba(74, 111, 212, 60);
}}

/* ── Listas e Árvores ── */
QListWidget, QTreeWidget {{
    background-color: {bg_surface};
    border: 1px solid {border};
    border-radius: {radius_sm}px;
    color: {text_primary};
    outline: none;
}}
QListWidget::item, QTreeWidget::item {{
    padding: 5px 6px;
    border-radius: 4px;
}}
QListWidget::item:hover, QTreeWidget::item:hover {{
    background-color: {bg_surface_alt};
}}
QListWidget::item:selected, QTreeWidget::item:selected {{
    background-color: rgba(74, 111, 212, 50);
    color: {senai_blue_light};
}}
QHeaderView::section {{
    background-color: {bg_surface};
    color: {text_secondary};
    border: none;
    border-bottom: 1px solid {border};
    padding: 4px 8px;
    font-size: {size_caption}px;
    font-weight: {weight_semibold};
    text-transform: uppercase;
    letter-spacing: 1px;
}}

/* ── Scrollbars ── */
QScrollBar:vertical {{
    background: transparent;
    width: 6px;
    margin: 2px;
}}
QScrollBar::handle:vertical {{
    background: {border_strong};
    border-radius: 3px;
    min-height: 30px;
}}
QScrollBar::handle:vertical:hover {{
    background: {senai_blue_light};
}}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {{
    height: 0px;
}}
QScrollBar:horizontal {{
    background: transparent;
    height: 6px;
    margin: 2px;
}}
QScrollBar::handle:horizontal {{
    background: {border_strong};
    border-radius: 3px;
    min-width: 30px;
}}
QScrollBar::handle:horizontal:hover {{
    background: {senai_blue_light};
}}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {{
    width: 0px;
}}

/* ── Splitter ── */
QSplitter::handle {{
    background-color: {border};
}}
QSplitter::handle:horizontal {{
    width: 1px;
}}
QSplitter::handle:vertical {{
    height: 1px;
}}

/* ── CheckBox ── */
QCheckBox {{
    color: {text_primary};
    spacing: 8px;
}}
QCheckBox::indicator {{
    width: 16px;
    height: 16px;
    border: 1.5px solid {border_strong};
    border-radius: 4px;
    background-color: {bg_surface_alt};
}}
QCheckBox::indicator:checked {{
    background-color: {senai_blue};
    border-color: {senai_blue};
}}
QCheckBox::indicator:hover {{
    border-color: {senai_blue_light};
}}

/* ── MessageBox ── */
QMessageBox {{
    background-color: {bg_surface};
}}
QMessageBox QLabel {{
    color: {text_primary};
}}

/* ── QPushButton padrão (fallback) ── */
QPushButton {{
    color: {text_primary};
    background-color: {bg_surface_alt};
    border: 1px solid {border};
    border-radius: {radius_sm}px;
    padding: 6px 14px;
}}
QPushButton:hover {{
    background-color: {bg_elevated};
    border-color: {border_strong};
}}
